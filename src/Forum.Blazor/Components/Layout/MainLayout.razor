@inherits LayoutComponentBase

<div class="site-wrapper">
    <header class="main-header">
        <div class="top-row-black">
            <div class="header-container">
                <div class="brand">
                    <a href="/">SPORT<span class="red-text">FORUM</span></a>
                </div>
                <div class="user-actions">
                    <div class="forum-search-container">
                        <i class="bi bi-search search-icon"></i>
                        <input type="text" class="search-input" placeholder="Search this forum..." />
                    </div>
                    <button class="btn-outline">Log In</button>
                    <button class="btn-red">Register</button>
                </div>
            </div>
        </div>
        <nav class="sub-nav-white">
            <div class="header-container">
                <ul class="nav-menu">
                    <li><a href="/category/football" class="active">Football</a></li>
                    <li><a href="/category/basketball">Basketball</a></li>
                    <li><a href="/category/tennis">Tennis</a></li>
                    <li><a href="/category/formula1">Formula 1</a></li>
                    <li><a href="/" class="active">News</a></li>
                    <li><a href="/threads">Forums</a></li>
                    <li><a href="/">Magazine</a></li>
                    <li><a href="/">Live Results</a></li>
                    <AuthorizeView Roles="Admin">
                        <Authorized>
                            <li><a href="/admin" class="admin-link">Admin</a></li>
                        </Authorized>
                    </AuthorizeView>
                </ul>
            </div>
        </nav>
    </header>

    <main class="main-body">
        <div class="header-container">
            @Body
        </div>
    </main>

    <footer class="main-footer">
        <div class="header-container footer-content">
            <p>&copy; 2026 Sport Forum Digital Media. All rights reserved.</p>
            <div class="footer-links">
                <a href="#">About Us</a> | <a href="#">Terms of Service</a> | <a href="#">Privacy Policy</a>
            </div>
        </div>
    </footer>
</div>