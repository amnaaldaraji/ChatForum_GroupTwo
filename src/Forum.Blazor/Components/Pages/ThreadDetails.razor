@page "/thread/{Id:int}"
@inject ThreadService ThreadService
@inject CommentService CommentService
@inject IJSRuntime JS

<link rel="stylesheet" href="/css/thread-details.css" />

<PageTitle>Thread Details</PageTitle>

<!-- Loading / not-found / content states -->
@if (_isLoading)
{
    <div class="loading">Loading thread...</div>
}
else if (_thread == null)
{
    <div class="error">Thread not found.</div>
}
else
{
    <div class="thread-details">
        <nav class="breadcrumb-trail">
            <a href="/">Overtime</a>
            <span> &rsaquo; </span>
            <a href="/category/@_thread.CategoryName">@_thread.CategoryName.ToUpper()</a>
            <span> &rsaquo; </span>
            <span class="breadcrumb-current">@_thread.Title</span>
        </nav>

        <div class="thread-header">
            <!-- Inline title edit form — replaces the static title when editing -->
            @if (_isEditingTitle)
            {
                <div class="d-flex align-items-center gap-2 mb-2">
                    <input type="text" class="form-control" @bind="_editTitleValue" />
                    <button class="btn btn-primary btn-sm" @onclick="SaveTitleEdit" disabled="@_isSubmitting">Save</button>
                    <button class="btn btn-secondary btn-sm" @onclick="CancelTitleEdit">Cancel</button>
                </div>
            }
            else
            {
                <h1>@_thread.Title</h1>
            }
            <div class="thread-meta">
                <span>started by <strong>@_thread.AuthorUserName</strong></span>
                <span>@_thread.TimeCreated.ToString("MMM dd, yyyy")</span>
                <span>in <strong>@_thread.CategoryName</strong></span>
            </div>
            <!-- Edit button — visible to admins and the thread's own author -->
            <AuthorizeView>
                <Authorized Context="threadEditAuth">
                    @if (threadEditAuth.User.IsInRole("Admin") || threadEditAuth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == _thread.AuthorId)
                    {
                        <button class="btn btn-link btn-sm p-0 mt-2" @onclick="StartTitleEdit">Edit</button>
                    }
                </Authorized>
            </AuthorizeView>
        </div>

        <!-- The thread body is stored as a special root comment on the thread -->
        @if (_thread.BodyComment != null && !string.IsNullOrEmpty(_thread.BodyComment.Content))
        {
            <div class="body-comment">
                <!-- Inline body edit form — replaces the static body when editing -->
                @if (_isEditingBody)
                {
                    <textarea class="form-control" rows="5" @bind="_editBodyValue"></textarea>
                    <div class="mt-3">
                        <button class="btn btn-primary btn-sm" @onclick="SaveBodyEdit" disabled="@_isSubmitting">Save</button>
                        <button class="btn btn-secondary btn-sm ms-1" @onclick="CancelBodyEdit">Cancel</button>
                    </div>
                }
                else
                {
                    <div class="comment-content">@_thread.BodyComment.Content</div>
                    <!-- Edit button — visible to admins and the body comment's own author -->
                    <AuthorizeView>
                        <Authorized Context="bodyEditAuth">
                            @if (bodyEditAuth.User.IsInRole("Admin") || bodyEditAuth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == _thread.BodyComment.AuthorId)
                            {
                                <button class="btn btn-link btn-sm p-0 mt-2" @onclick="StartBodyEdit">Edit</button>
                            }
                        </Authorized>
                    </AuthorizeView>
                }
            </div>
        }

        @if (!string.IsNullOrEmpty(_editError))
        {
            <div class="alert alert-danger">@_editError</div>
        }

        <!-- Total comments in thread -->
        <div class="comments-section">
            <h3>comments (@(_commentsPage?.TotalCount ?? 0))</h3>

            <!-- Page size selector — resets to page 1 on change -->
            <div class="d-flex align-items-center mb-2">
                <label class="me-2 mb-0">Comments per page:</label>
                <select class="form-select form-select-sm w-auto" value="@_pageSize" @onchange="OnPageSizeChanged">
                    @foreach (var size in new[] { 5, 10, 15, 20 })
                    {
                        <option value="@size">@size</option>
                    }
                </select>

                <!-- Pagination controls — only rendered when there is more than one page -->
                <div class="ms-auto">
                    @if (_commentsPage != null && _commentsPage.TotalPages > 1)
                    {
                        <nav aria-label="Comment pagination">
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(_pageNumber == 1 ? "disabled" : "")">
                                    <button class="page-link" @onclick="PrevPage">Prev</button>
                                </li>
                                @{
                                    // Collapsed pagination: show first, last, and neighbors of current page with ellipses
                                    var totalPages = _commentsPage.TotalPages;
                                    var pagesToShow = new SortedSet<int>();
                                    pagesToShow.Add(1);
                                    pagesToShow.Add(totalPages);
                                    if (_pageNumber > 1) pagesToShow.Add(_pageNumber - 1);
                                    pagesToShow.Add(_pageNumber);
                                    if (_pageNumber < totalPages) pagesToShow.Add(_pageNumber + 1);

                                    int? lastShown = null;
                                    foreach (var pageNum in pagesToShow)
                                    {
                                        // Insert ellipsis between non-consecutive page numbers
                                        if (lastShown.HasValue && pageNum - lastShown.Value > 1)
                                        {
                                            <li class="page-item disabled"><span class="page-link">...</span></li>
                                        }
                                        <li class="page-item @(pageNum == _pageNumber ? "active" : "")">
                                            <button class="page-link" @onclick="() => GoToPage(pageNum)">@pageNum</button>
                                        </li>
                                        lastShown = pageNum;
                                    }
                                }
                                <li class="page-item @(_pageNumber == _commentsPage.TotalPages ? "disabled" : "")">
                                    <button class="page-link" @onclick="NextPage">Next</button>
                                </li>
                            </ul>
                        </nav>
                    }
                </div>
            </div>

            @if (_commentsPage?.Items == null || !_commentsPage.Items.Any())
            {
                <div class="no-comments">No comments yet.</div>
            }
            else
            {
                @foreach (var comment in _commentsPage.Items)
                {
                    <div class="comment">
                        <div class="comment-header">
                            <strong>@comment.AuthorUserName</strong>
                            <span class="comment-time">@comment.TimeCreated.ToString("MMM dd, yyyy")</span>
                            
                            <!-- Show which comment this is a reply to, if applicable -->
                            @if (!string.IsNullOrEmpty(comment.ParentCommentAuthorUserName))
                            {
                                <span class="reply-info">replying to @comment.ParentCommentAuthorUserName</span>
                            }
                        </div>
                        
                        <!-- Quote the parent comment content (truncated) when this is a reply -->
                        @if (!string.IsNullOrEmpty(comment.ParentCommentContent))
                        {
                            <div class="reply-citation">
                                <span class="reply-citation-author">@comment.ParentCommentAuthorUserName</span>
                                <span class="reply-citation-content">@TruncateContent(comment.ParentCommentContent, 200)</span>
                            </div>
                        }
                        <!-- Inline comment edit form — replaces the static body when editing -->
                        @if (_editingCommentId == comment.CommentId)
                        {
                            <div class="reply-form">
                                <textarea class="form-control" rows="3" @bind="_editCommentValue"></textarea>
                                <div class="mt-3">
                                    <button class="btn btn-primary btn-sm" @onclick="() => SaveCommentEdit(comment.CommentId)" disabled="@_isSubmitting">Save</button>
                                    <button class="btn btn-secondary btn-sm ms-1" @onclick="CancelCommentEdit">Cancel</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="comment-body">@comment.Content</div>
                        }

                        <div class="comment-footer">
                            
                            <!-- Vote buttons -->
                            <AuthorizeView>
                                <Authorized>
                                    
                                    <!-- Active class is applied when the user has already voted in that direction -->
                                    <div class="vote-bar">
                                        <button class="vote-btn upvote @(GetUserVote(comment.CommentId) == 1 ? "active-up" : "")"
                                                @onclick="async () => await Vote(comment.CommentId, 1)"
                                                title="Upvote">▲</button>
                                        
                                        <!-- Score color changes based on positive/negative/zero value -->
                                        <span class="vote-score @(GetScore(comment.CommentId) > 0 ? "score-positive" : GetScore(comment.CommentId) < 0 ? "score-negative" : "score-zero")">
                                            @GetScore(comment.CommentId)
                                        </span>
                                        <button class="vote-btn downvote @(GetUserVote(comment.CommentId) == -1 ? "active-down" : "")"
                                                @onclick="async () => await Vote(comment.CommentId, -1)"
                                                title="Downvote">▼</button>
                                    </div>
                                </Authorized>
                                
                                <!-- Unauthenticated users see disabled vote buttons -->
                                <NotAuthorized>
                                    <div class="vote-bar vote-bar-locked" title="Log in to vote">
                                        <button class="vote-btn upvote locked" disabled>▲</button>
                                        <span class="vote-score score-zero">@GetScore(comment.CommentId)</span>
                                        <button class="vote-btn downvote locked" disabled>▼</button>
                                    </div>
                                </NotAuthorized>
                            </AuthorizeView>

                            <!-- Reply button — only shown when not already replying to this comment -->
                            <AuthorizeView>
                                <Authorized Context="replyAuth">
                                    @if (_replyingToCommentId != comment.CommentId)
                                    {
                                        <button class="btn btn-link btn-sm p-0" @onclick="() => StartReply(comment.CommentId)">Reply</button>
                                    }
                                </Authorized>
                            </AuthorizeView>

                            <!-- Edit and Delete buttons — visible to admins and the comment's own author -->
                            @if (!comment.IsDeleted)
                            {
                                <AuthorizeView>
                                    <Authorized Context="editAuth">
                                        @if (editAuth.User.IsInRole("Admin") || editAuth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == comment.AuthorId)
                                        {
                                            @if (_editingCommentId != comment.CommentId)
                                            {
                                                <button class="btn btn-link btn-sm p-0 ms-2" title="Edit comment"
                                                        @onclick="() => StartCommentEdit(comment.CommentId, comment.Content)">
                                                    Edit
                                                </button>
                                            }
                                        }
                                    </Authorized>
                                </AuthorizeView>
                                <AuthorizeView>
                                    <Authorized Context="deleteAuth">
                                        @if (deleteAuth.User.IsInRole("Admin") || deleteAuth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == comment.AuthorId)
                                        {
                                            <button class="btn btn-link btn-sm text-danger p-0 ms-2" title="Delete comment"
                                                    @onclick="() => ConfirmAndDelete(comment.CommentId)" disabled="@_isSubmitting">
                                                Delete
                                            </button>
                                        }
                                    </Authorized>
                                </AuthorizeView>
                            }
                        </div>

                        <!-- Inline reply form — only shown for the comment currently being replied to -->
                        <AuthorizeView>
                            <Authorized Context="replyFormAuth">
                                @if (_replyingToCommentId == comment.CommentId)
                                {
                                    <div class="reply-form">
                                        <textarea class="form-control" rows="3" placeholder="Write a reply to @comment.AuthorUserName..." @bind="_replyContent"></textarea>
                                        <div class="mt-3">
                                            <button class="btn btn-primary btn-sm" @onclick="() => SubmitReply(comment.CommentId)" disabled="@_isSubmitting">Reply</button>
                                            <button class="btn btn-secondary btn-sm ms-1" @onclick="CancelReply">Cancel</button>
                                        </div>
                                    </div>
                                }
                            </Authorized>
                        </AuthorizeView>
                    </div>
                }
            }
        </div>

        <!-- New top-level comment form at the bottom of the thread - users/admins only -->
        <AuthorizeView>
            <Authorized>
                <div class="add-comment">
                    @if (!string.IsNullOrEmpty(_commentError))
                    {
                        <div class="alert alert-danger">@_commentError</div>
                    }
                    <textarea class="form-control" rows="3" placeholder="Write a comment..." @bind="_newCommentContent"></textarea>
                    <button class="btn btn-primary mt-3" @onclick="SubmitComment" disabled="@_isSubmitting">
                        @if (_isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Post Comment
                    </button>
                </div>
            </Authorized>
            
            <!-- Prompt unauthenticated users to log in or register to participate -->
            <NotAuthorized>
                <div class="auth-prompt">
                    <span class="auth-prompt-icon">💬</span>
                    <p>Want to join the conversation?</p>
                    <div class="auth-prompt-links">
                        <a href="/login" class="auth-link">Log in</a>
                        <span>or</span>
                        <a href="/register" class="auth-link">Register</a>
                    </div>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }
    private ThreadDetailDto? _thread;
    private bool _isLoading = true;
    private PagedResult<CommentDto>? _commentsPage;
    private int _pageNumber = 1;
    private int _pageSize = 10;
    private string _newCommentContent = string.Empty;
    private string _commentError = string.Empty;
    private bool _isSubmitting;
    private int? _replyingToCommentId;
    private string _replyContent = string.Empty;

    // Edit/delete state
    private bool _isEditingTitle;
    private string _editTitleValue = string.Empty;
    private bool _isEditingBody;
    private string _editBodyValue = string.Empty;
    private int? _editingCommentId;
    private string _editCommentValue = string.Empty;
    private string _editError = string.Empty;

    // Local vote state — kept in sync after each vote API call to avoid full page reload
    private Dictionary<int, int> _voteScores = [];
    private Dictionary<int, int> _userVotes = [];

    /// <summary>
    /// Re-runs when navigating between threads without a full component remount.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        await LoadThread();
    }

    /// <summary>
    /// Loads the thread and its comments.
    /// </summary>
    private async Task LoadThread()
    {
        _isLoading = true;
        try
        {
            _thread = await ThreadService.GetByIdAsync(Id);
            await LoadComments();
        }
        catch
        {
            _thread = null;
        }
        finally
        {
            _isLoading = false;
        }
    }

    /// <summary>
    /// Loads comments for the current thread page.
    /// </summary>
    private async Task LoadComments(int? page = null)
    {
        var pageToLoad = page ?? _pageNumber;
        try
        {
            _commentsPage = await CommentService.GetByThreadAsync(Id, pageToLoad, _pageSize);
            if (_commentsPage != null)
            {
                _pageNumber = _commentsPage.PageNumber;
                PopulateVoteData();         // Sync local vote caches from the fresh server response
            }
        }
        catch
        {
            _commentsPage = null;
        }
        StateHasChanged();
    }

    /// <summary>
    /// Seed local vote caches from the server response so votes render instantly without re-fetching.
    /// </summary>
    private void PopulateVoteData()
    {
        if (_commentsPage?.Items == null) return;
        foreach (var c in _commentsPage.Items)
        {
            _voteScores[c.CommentId] = c.VoteScore;
            _userVotes[c.CommentId] = c.CurrentUserVote ?? 0;
        }
    }

    /// <summary>
    /// Returns the net vote score for a comment, defaulting to 0 if not yet loaded.
    /// </summary>
    private int GetScore(int commentId) =>
        _voteScores.TryGetValue(commentId, out var s) ? s : 0;

    /// <summary>
    /// Returns the current user's vote for a comment (1, -1, or 0 if not voted).
    /// </summary>
    private int GetUserVote(int commentId) =>
        _userVotes.TryGetValue(commentId, out var v) ? v : 0;

    /// <summary>
    /// Casts a vote and updates local caches immediately so the UI reflects the new state without a full reload.
    /// </summary>
    private async Task Vote(int commentId, int direction)
    {
        var result = await CommentService.CastVoteAsync(commentId, direction);
        if (result != null)
        {
            _voteScores[commentId] = result.NewScore;
            _userVotes[commentId] = result.UserVote;
        }
    }

    /// <summary>
    /// Updates page size when changed.
    /// </summary>
    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (e?.Value == null) return;
        if (!int.TryParse(e.Value.ToString(), out var newSize)) return;
        if (newSize == _pageSize) return;
        _pageSize = newSize;
        _pageNumber = 1;            // Reset to first page on page size change
        await LoadComments(_pageNumber);
    }

    /// <summary>
    /// Enter reply mode for the selected comment.
    /// </summary>
    private void StartReply(int commentId)
    {
        CancelAllEditing();
        _replyingToCommentId = commentId;
        _replyContent = string.Empty;
    }

    /// <summary>
    /// Exit reply mode without submitting.
    /// </summary>
    private void CancelReply()
    {
        _replyingToCommentId = null;
        _replyContent = string.Empty;
    }

    /// <summary>
    /// Submits a reply to the specified parent comment.
    /// </summary>
    private async Task SubmitReply(int parentCommentId)
    {
        if (string.IsNullOrWhiteSpace(_replyContent)) return;
        _isSubmitting = true;
        try
        {
            var dto = new CreateCommentDto(_replyContent.Trim(), parentCommentId);
            var response = await CommentService.CreateAsync(Id, dto);
            if (response.IsSuccessStatusCode)
            {
                // Clear reply state and refresh comments on success
                _replyingToCommentId = null;
                _replyContent = string.Empty;
                await LoadComments(_pageNumber);
            }
        }
        catch { }
        finally { _isSubmitting = false; }
    }

    /// <summary>
    /// Shortens long parent comment content for the reply citation block.
    /// </summary>
    private static string TruncateContent(string content, int maxLength)
    {
        if (content.Length <= maxLength) return content;
        return content[..maxLength] + "...";
    }

    /// <summary>
    /// Submits a new top-level comment on the thread.
    /// </summary>
    private async Task SubmitComment()
    {
        _commentError = string.Empty;
        if (string.IsNullOrWhiteSpace(_newCommentContent))
        {
            _commentError = "Comment cannot be empty.";
            return;
        }
        _isSubmitting = true;
        try
        {
            var dto = new CreateCommentDto(_newCommentContent.Trim());
            var response = await CommentService.CreateAsync(Id, dto);
            if (response.IsSuccessStatusCode)
            {
                _newCommentContent = string.Empty; // Clear the input on success
                await LoadComments(_pageNumber);
            }
            else
            {
                _commentError = "Failed to post comment.";
            }
        }
        catch (Exception ex)
        {
            _commentError = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    /// <summary>
    /// Used to access the previous page of comments.
    /// </summary>
    private async Task PrevPage()
    {
        if (_commentsPage is null || !_commentsPage.HasPreviousPage) return;
        _pageNumber = Math.Max(1, _pageNumber - 1);
        await LoadComments(_pageNumber);
    }

    /// <summary>
    /// Used to access the next page of comments.
    /// </summary>
    private async Task NextPage()
    {
        if (_commentsPage is null || !_commentsPage.HasNextPage) return;
        _pageNumber = Math.Min(_commentsPage.TotalPages, _pageNumber + 1);
        await LoadComments(_pageNumber);
    }

    /// <summary>
    /// Used to navigate to a specific page of comments.
    /// </summary>
    private async Task GoToPage(int p)
    {
        if (_commentsPage is null) return;
        if (p < 1 || p > _commentsPage.TotalPages) return;
        _pageNumber = p;
        await LoadComments(_pageNumber);
    }

    /// <summary>
    /// Shows a browser confirm dialog before deleting a comment.
    /// </summary>
    private async Task ConfirmAndDelete(int commentId)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this comment?");
        if (!confirmed) return;
        await DeleteComment(commentId);
    }

    /// <summary>
    /// Deletes a comment (soft-delete).
    /// </summary>
    private async Task DeleteComment(int commentId)
    {
        _commentError = string.Empty;
        _isSubmitting = true;
        try
        {
            var response = await CommentService.DeleteAsync(commentId);
            if (response.IsSuccessStatusCode)
            {
                await LoadComments(_pageNumber);    // Refresh the current page after deletion
            }
            else
            {
                _commentError = "Failed to delete comment.";
            }
        }
        catch (Exception ex)
        {
            _commentError = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    /// <summary>
    /// Formats a DateTime for display.
    /// </summary>
    private static string FormatDate(DateTime dt) => dt.ToString("MMM dd, yyyy");

    /// <summary>
    /// Closes any open edit or reply form so only one is active at a time.
    /// </summary>
    private void CancelAllEditing()
    {
        _isEditingTitle = false;
        _editTitleValue = string.Empty;
        _isEditingBody = false;
        _editBodyValue = string.Empty;
        _editingCommentId = null;
        _editCommentValue = string.Empty;
        _replyingToCommentId = null;
        _replyContent = string.Empty;
        _editError = string.Empty;
    }

    /// <summary>
    /// Enter title editing mode, pre-populating the input with the current title.
    /// </summary>
    private void StartTitleEdit()
    {
        CancelAllEditing();
        _isEditingTitle = true;
        _editTitleValue = _thread!.Title;
    }

    /// <summary>
    /// Exit title editing mode without saving.
    /// </summary>
    private void CancelTitleEdit()
    {
        _isEditingTitle = false;
        _editTitleValue = string.Empty;
        _editError = string.Empty;
    }

    /// <summary>
    /// Saves the edited title via the API and reloads the thread on success.
    /// </summary>
    private async Task SaveTitleEdit()
    {
        if (string.IsNullOrWhiteSpace(_editTitleValue)) return;
        _editError = string.Empty;
        _isSubmitting = true;
        try
        {
            var dto = new UpdateThreadDto(Title: _editTitleValue.Trim());
            var response = await ThreadService.UpdateAsync(Id, dto);
            if (response.IsSuccessStatusCode)
            {
                _isEditingTitle = false;
                _editTitleValue = string.Empty;
                await LoadThread();
            }
            else
            {
                _editError = "Failed to update thread title.";
            }
        }
        catch (Exception ex)
        {
            _editError = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    /// <summary>
    /// Enter body editing mode, pre-populating the textarea with the current body content.
    /// </summary>
    private void StartBodyEdit()
    {
        CancelAllEditing();
        _isEditingBody = true;
        _editBodyValue = _thread!.BodyComment!.Content;
    }

    /// <summary>
    /// Exit body editing mode without saving.
    /// </summary>
    private void CancelBodyEdit()
    {
        _isEditingBody = false;
        _editBodyValue = string.Empty;
        _editError = string.Empty;
    }

    /// <summary>
    /// Saves the edited body content via CommentService and reloads the thread on success.
    /// </summary>
    private async Task SaveBodyEdit()
    {
        if (string.IsNullOrWhiteSpace(_editBodyValue)) return;
        _editError = string.Empty;
        _isSubmitting = true;
        try
        {
            var dto = new UpdateCommentDto(_editBodyValue.Trim());
            var response = await CommentService.UpdateAsync(_thread!.BodyComment!.CommentId, dto);
            if (response.IsSuccessStatusCode)
            {
                _isEditingBody = false;
                _editBodyValue = string.Empty;
                await LoadThread();
            }
            else
            {
                _editError = "Failed to update thread body.";
            }
        }
        catch (Exception ex)
        {
            _editError = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    /// <summary>
    /// Enter comment editing mode for the specified comment.
    /// </summary>
    private void StartCommentEdit(int commentId, string currentContent)
    {
        CancelAllEditing();
        _editingCommentId = commentId;
        _editCommentValue = currentContent;
    }

    /// <summary>
    /// Exit comment editing mode without saving.
    /// </summary>
    private void CancelCommentEdit()
    {
        _editingCommentId = null;
        _editCommentValue = string.Empty;
        _editError = string.Empty;
    }

    /// <summary>
    /// Saves the edited comment content and reloads comments on success.
    /// </summary>
    private async Task SaveCommentEdit(int commentId)
    {
        if (string.IsNullOrWhiteSpace(_editCommentValue)) return;
        _editError = string.Empty;
        _isSubmitting = true;
        try
        {
            var dto = new UpdateCommentDto(_editCommentValue.Trim());
            var response = await CommentService.UpdateAsync(commentId, dto);
            if (response.IsSuccessStatusCode)
            {
                _editingCommentId = null;
                _editCommentValue = string.Empty;
                await LoadComments(_pageNumber);
            }
            else
            {
                _editError = "Failed to update comment.";
            }
        }
        catch (Exception ex)
        {
            _editError = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}