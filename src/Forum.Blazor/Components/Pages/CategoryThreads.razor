@page "/category/{CategoryName}"
@rendermode InteractiveServer

<PageTitle>@CategoryName - Sport Forum</PageTitle>

<link rel="stylesheet" href="/css/category.css" />

<div class="category-page">
    <div class="category-hero @(CategoryName.ToLower())">
        <div class="hero-content">
            <h1 class="category-title">@CategoryName.ToUpper()</h1>
            <p class="category-description">discussions about @CategoryName.ToLower()</p>
        </div>
    </div>

    @if (_threads == null)
    {
        <div class="loading">loading threads...</div>
    }
    else if (!_threads.Any())
    {
        <div class="no-threads">no threads in @CategoryName yet. be the first to start a discussion!</div>
    }
    else
    {
        <div class="forum-view-wrapper">
            <div class="autosport-table">
                <table class="threads-table">
                    <thead>
                        <tr>
                            <th>thread</th>
                            <th>author</th>
                            <th>replies</th>
                            <th>last activity</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var thread in _threads)
                        {
                            <tr class="thread-row">
                                <td class="thread-title-cell">
                                    <a href="/thread/@thread.Id" class="thread-title">@thread.Title</a>
                                </td>
                                <td class="author-cell">@thread.Author</td>
                                <td class="replies-cell">@thread.CommentsCount</td>
                                <td class="activity-cell">@thread.Created.ToString("MMM dd, yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="create-thread-section">
        <a href="/create-thread" class="btn btn-primary">create new thread</a>
    </div>
</div>

@code {
    [Parameter]
    public string CategoryName { get; set; } = string.Empty;

    private List<ThreadDto>? _threads;

    // thread dto with requested property names
    private record ThreadDto(
        int Id,
        string Author,
        DateTime Created,
        string Title,
        int CommentsCount
    );

    protected override void OnInitialized()
    {
        LoadCategoryThreads();
    }

    private void LoadCategoryThreads()
    {
        // mockup data for different sports categories
        _threads = CategoryName.ToLower() switch
        {
            "football" => GetFootballThreads(),
            "basketball" => GetBasketballThreads(),
            "tennis" => GetTennisThreads(),
            "formula1" => GetFormula1Threads(),
            _ => []
        };
    }

    // mockup football threads
    private List<ThreadDto> GetFootballThreads()
    {
        return [
            new(1, "JohnSmith", DateTime.Now.AddDays(-5), "Manchester United vs Liverpool - Match Discussion", 45),
            new(2, "FootballFan92", DateTime.Now.AddDays(-3), "Best Premier League Goals This Season", 23),
            new(3, "SoccerExpert", DateTime.Now.AddDays(-1), "World Cup 2026 Predictions", 67),
            new(4, "GoalKeeper", DateTime.Now.AddDays(-2), "Messi vs Ronaldo - Final Verdict", 128),
            new(5, "TacticalMaster", DateTime.Now.AddDays(-4), "4-3-3 vs 3-5-2 Formation Analysis", 34)
        ];
    }

    // mockup basketball threads
    private List<ThreadDto> GetBasketballThreads()
    {
        return [
            new(6, "HoopsFan", DateTime.Now.AddDays(-4), "Lakers vs Celtics - Rivalry Renewed", 89),
            new(7, "BasketballGuru", DateTime.Now.AddDays(-2), "LeBron James - Greatest of All Time?", 156),
            new(8, "ThreePointer", DateTime.Now.AddDays(-1), "NBA Playoffs Predictions 2026", 78),
            new(9, "DunkMaster", DateTime.Now.AddDays(-3), "Best Dunks of the Season So Far", 45),
