@page "/"
@inject CategoryService CategoryService
@inject ThreadService ThreadService

<PageTitle>Sport Forum</PageTitle>

<link rel="stylesheet" href="/css/home.css" />

<div class="forum-home">
    <div class="hero-section">
        <div class="hero-content">
            <h1 class="hero-title">Sport Forum</h1>
            <p class="hero-description">The place for debates on current affairs and recent past of motorsport and all sports.</p>
        </div>
    </div>

    @if (_categories == null)
    {
        <div class="loading">loading categories...</div>
    }
    else
    {
        @foreach (var category in _categories)
        {
            <div class="category-section">
                <div class="category-header">
                    <h2>@category.Name</h2>
                    <a href="/category/@category.Name" class="view-all-link">View all threads →</a>
                </div>

                @if (category.RecentThreads == null || !category.RecentThreads.Any())
                {
                    <div class="no-threads">no threads in this category yet.</div>
                }
                else
                {
                    <div class="recent-threads">
                        @foreach (var thread in category.RecentThreads)
                        {
                            <div class="thread-item">
                                <div class="thread-info">
                                    <a href="/thread/@thread.ThreadId" class="thread-title">@thread.Title</a>
                                    <div class="thread-meta">
                                        started by <span class="author">@thread.AuthorUserName</span> •
                                        @thread.TimeCreated.ToString("MMM dd, yyyy") •
                                        @thread.CommentCount replies
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private List<CategoryWithThreads>? _categories;

    private class CategoryWithThreads
    {
        public string Name { get; set; } = string.Empty;
        public List<ThreadSummaryDto> RecentThreads { get; set; } = [];
    }

    protected override async Task OnInitializedAsync()
    {
        var categories = await CategoryService.GetAllAsync();
        if (categories == null) return;

        _categories = [];
        foreach (var cat in categories)
        {
            var filter = new ThreadFilterParams
            {
                CategoryId = cat.CategoryId,
                PageSize = 3,
                SortBy = ThreadSortBy.Newest
            };
            var result = await ThreadService.GetThreadsAsync(filter);
            _categories.Add(new CategoryWithThreads
            {
                Name = cat.Name,
                RecentThreads = result?.Items?.ToList() ?? []
            });
        }
    }
}
