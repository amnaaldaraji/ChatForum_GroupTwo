@page "/"
@inject CategoryService CategoryService
@inject ThreadService ThreadService

<PageTitle>Sport Forum</PageTitle>

<link rel="stylesheet" href="/css/home.css" />

<div class="home-wrapper">
    <div class="home-overlay">

        <div class="home-header">
            <h1 class="hero-title">SPORT<span class="hero-red">FORUM</span></h1>
            <p class="hero-sub">Debates on current affairs and recent past of motorsport and all sports.</p>
        </div>

        <div class="home-content">

            @* vänster kolumn – senaste kommentarer *@
            <div class="side-panel left-panel">
                <div class="side-title">Latest Activity</div>
                @if (_recentComments != null)
                {
                    @foreach (var comment in _recentComments)
                    {
                        <div class="activity-card">
                            <div class="activity-author">@comment.AuthorUserName</div>
                            <div class="activity-thread">@comment.ThreadTitle</div>
                            <div class="activity-preview">@comment.Content</div>
                            <div class="activity-time">@comment.TimeCreated.ToString("MMM dd, yyyy")</div>
                        </div>
                    }
                }
            </div>

            @* mitten – kategorilista *@
            <div class="forum-home">
                @if (_categories == null)
                {
                    <div class="loading">loading categories...</div>
                }
                else
                {
                    <div class="categories-list">
                        @foreach (var category in _categories)
                        {
                            <div class="category-card">
                                <div class="category-header">
                                    <span class="cat-name">@category.Name</span>
                                    <a href="/category/@category.Name" class="view-all-link">View all &rarr;</a>
                                </div>

                                @if (category.RecentThreads == null || !category.RecentThreads.Any())
                                {
                                    <div class="no-threads">no threads yet.</div>
                                }
                                else
                                {
                                    <div class="recent-threads">
                                        @foreach (var thread in category.RecentThreads)
                                        {
                                            <div class="thread-item">
                                                <div class="thread-left">
                                                    <a href="/thread/@thread.ThreadId" class="thread-title">@thread.Title</a>
                                                    <div class="thread-meta">
                                                        <span class="author">@thread.AuthorUserName</span>
                                                        <span class="dot">&bull;</span>
                                                        <span class="date">@thread.TimeCreated.ToString("MMM dd, yyyy")</span>
                                                    </div>
                                                </div>
                                                <div class="thread-right">
                                                    <span class="reply-count">@thread.CommentCount</span>
                                                    <span class="reply-label">replies</span>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            @* höger kolumn – populära trådar *@
            <div class="side-panel right-panel">
                <div class="side-title">Most Active</div>
                @if (_popularThreads != null)
                {
                    @foreach (var thread in _popularThreads)
                    {
                        <div class="activity-card">
                            <div class="activity-category">@thread.CategoryName</div>
                            <a href="/thread/@thread.ThreadId" class="activity-thread-link">@thread.Title</a>
                            <div class="activity-stats">
                                <span class="activity-author">@thread.AuthorUserName</span>
                                <span class="activity-replies">@thread.CommentCount replies</span>
                            </div>
                        </div>
                    }
                }
            </div>

        </div>
    </div>
</div>

@code {
    private List<CategoryWithThreads>? _categories;
    private List<RecentCommentItem>? _recentComments;
    private List<PopularThreadItem>? _popularThreads;

    private class CategoryWithThreads
    {
        public string Name { get; set; } = string.Empty;
        public int CategoryId { get; set; }
        public List<ThreadSummaryDto> RecentThreads { get; set; } = [];
    }

    private class RecentCommentItem
    {
        public string AuthorUserName { get; set; } = string.Empty;
        public string ThreadTitle { get; set; } = string.Empty;
        public string Content { get; set; } = string.Empty;
        public DateTime TimeCreated { get; set; }
    }

    private class PopularThreadItem
    {
        public int ThreadId { get; set; }
        public string Title { get; set; } = string.Empty;
        public string AuthorUserName { get; set; } = string.Empty;
        public string CategoryName { get; set; } = string.Empty;
        public int CommentCount { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        var categories = await CategoryService.GetAllAsync();
        if (categories == null) return;

        _categories = [];
        _popularThreads = [];

        foreach (var cat in categories)
        {
            // load 3 most recent threads per category
            var filter = new ThreadFilterParams
            {
                CategoryId = cat.CategoryId,
                PageSize = 3,
                SortBy = ThreadSortBy.Newest
            };
            var result = await ThreadService.GetThreadsAsync(filter);
            var threads = result?.Items?.ToList() ?? [];

            _categories.Add(new CategoryWithThreads
            {
                Name = cat.Name,
                CategoryId = cat.CategoryId,
                RecentThreads = threads
            });

            // samla populära trådar från alla kategorier
            foreach (var t in threads)
            {
                _popularThreads.Add(new PopularThreadItem
                {
                    ThreadId = t.ThreadId,
                    Title = t.Title,
                    AuthorUserName = t.AuthorUserName,
                    CategoryName = cat.Name,
                    CommentCount = t.CommentCount
                });
            }
        }

        // sortera på mest kommentarer och ta top 6
        _popularThreads = _popularThreads
            .OrderByDescending(t => t.CommentCount)
            .Take(6)
            .ToList();

        // bygg senaste aktivitet från nyaste trådar
        _recentComments = _categories
            .SelectMany(c => c.RecentThreads.Select(t => new RecentCommentItem
            {
                AuthorUserName = t.AuthorUserName,
                ThreadTitle = t.Title,
                Content = c.Name,
                TimeCreated = t.TimeCreated
            }))
            .OrderByDescending(x => x.TimeCreated)
            .Take(6)
            .ToList();
    }
}