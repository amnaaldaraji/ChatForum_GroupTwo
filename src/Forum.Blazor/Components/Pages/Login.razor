@*
    Login.razor - User login page (route: "/login").

    Displays a centered card with a login form containing:
    - Username and password input fields bound to a local LoginModel
    - Form validation via DataAnnotationsValidator and ValidationSummary
    - Error message display for failed login attempts
    - Loading spinner on the submit button while the request is in progress
    - Link to the registration page for users without an account

    On successful login, the user is redirected to the home page ("/").
    Authentication is handled via AuthService which manages JWT token storage
    and authentication state updates.
*@
@page "/login"
@using Forum.Application.DTOs.Auth
@using Forum.Blazor.Services
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Login</PageTitle>

@* Centered card layout for the login form *@
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h3>Login</h3>
            </div>
            <div class="card-body">
                @* Error alert shown when login fails (invalid credentials, server error, etc.) *@
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger">
                        @errorMessage
                    </div>
                }
                @* Login form with DataAnnotations validation and submit handler *@
                <EditForm Model="@loginModel" OnValidSubmit="HandleLogin" FormName="LoginForm">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    @* Username input field *@
                    <div class="mb-3">
                        <label for="username" class="form-label">Username</label>
                        <InputText id="username" class="form-control" @bind-Value="loginModel.Username" />
                    </div>

                    @* Password input field (type="password" masks the input) *@
                    <div class="mb-3">
                        <label for="password" class="form-label">Password</label>
                        <InputText id="password" type="password" class="form-control" @bind-Value="loginModel.Password" />
                    </div>

                    @* Submit button with loading spinner, disabled during request *@
                    <button type="submit" class="btn btn-primary" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Login
                    </button>
                    @* Navigation link to the register page *@
                    <a href="/register" class="btn btn-link">Don't have an account? Register</a>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    /// <summary>The form model containing the user's login credentials.</summary>
    private LoginModel loginModel = new();

    /// <summary>Error message displayed when login fails (e.g., invalid credentials).</summary>
    private string errorMessage = string.Empty;

    /// <summary>Loading state flag; disables the submit button while the login request is in progress.</summary>
    private bool isLoading = false;

    /// <summary>
    /// Handles the login form submission. Calls AuthService.LoginAsync with the provided
    /// credentials. On success, navigates to the home page. On failure, displays the error message.
    /// </summary>
    private async Task HandleLogin()
    {
        errorMessage = string.Empty;
        isLoading = true;

        try
        {
            var request = new LoginRequest(loginModel.Username, loginModel.Password);
            var authResponse = await AuthService.LoginAsync(request);

            if (authResponse != null)
            {
                Navigation.NavigateTo("/");
            }
            else
            {
                errorMessage = "Invalid username or password";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    /// <summary>
    /// Local model class for the login form. Holds the username and password
    /// entered by the user, bound to the EditForm via two-way binding.
    /// </summary>
    private class LoginModel
    {
        /// <summary>The username entered by the user.</summary>
        public string Username { get; set; } = string.Empty;

        /// <summary>The password entered by the user.</summary>
        public string Password { get; set; } = string.Empty;
    }
}
